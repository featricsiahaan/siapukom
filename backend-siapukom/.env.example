# Salin file ini menjadi .env dan sesuaikan nilainya sebelum menjalankan server.

# Connection string PostgreSQL. Contoh lokal:
# postgresql://postgres:postgres@localhost:5432/siapukom?schema=public
# Di Railway/Render/Supabase, salin connection string yang disediakan platform.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/siapukom?schema=public"

# Port HTTP yang dipakai server (banyak platform PaaS meng-override otomatis via env PORT).
PORT=4000

# Ganti dengan string acak yang panjang & rahasia sebelum deploy ke produksi.
JWT_SECRET="ganti-dengan-secret-acak-minimal-32-karakter"
JWT_EXPIRES_IN="7d"

# Origin frontend yang diizinkan mengakses API (pisahkan dengan koma jika lebih dari satu).
CORS_ORIGIN="http://localhost:5173"

NODE_ENV="development"
