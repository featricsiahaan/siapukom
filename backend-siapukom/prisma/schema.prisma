generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PESERTA
  ADMIN
}

enum SessionStatus {
  IN_PROGRESS
  FINISHED
}

enum SessionMode {
  LATIHAN
  SIMULASI
  KATEGORI
}

// Alur telaah 8-tahap sesuai Panduan Induk SKD2026 §11. DRAFT dan ACTIVE
// dipertahankan (bukan diganti DRAF/AKTIF) supaya soal existing di produksi
// tidak butuh migrasi data — hanya menambah tahap telaah di antaranya.
enum QuestionStatus {
  DRAFT
  TELAAH_SUMBER
  TELAAH_KLINIS
  TELAAH_SOAL
  SIAP_UJI_COBA
  ACTIVE
  DITAHAN
  DIARSIPKAN
}

// Area kompetensi SKD 2026 (Keputusan KKI No. HK.01.02/KKI/1291/2026, BAB III bagian A).
enum CompetencyArea {
  A1_KESELAMATAN_PASIEN
  A2_PENATALAKSANAAN_KLINIS
  A3_PROSEDUR_INTERVENSI_KLINIS
  A4_PROMOTIF_PREVENTIF
  A5_PROFESIONALISME
}

// 14 bagian klinis dari Panduan Induk SiapUKOM SKD2026 §4.
enum ClinicalModule {
  M01_SISTEM_SARAF
  M02_PSIKIATRI
  M03_SISTEM_INDERA
  M04_RESPIRASI
  M05_KARDIOVASKULER
  M06_GASTROINTESTINAL_HEPATOBILIER_PANKREAS
  M07_GINJAL_SALURAN_KEMIH
  M08_REPRODUKSI
  M09_ENDOKRIN_METABOLIK_NUTRISI
  M10_HEMATO_IMUNOLOGI
  M11_MUSKULOSKELETAL
  M12_KULIT_INTEGUMEN
  M13_FORENSIK_MEDIKOLEGAL
  M14_ANAK
}

// Kategori sumber per Panduan Induk §5 — kedalaman/batas skenario, bukan tingkat kesulitan.
enum SourceCategory {
  TUNTAS
  AWAL_RUJUK
  RUJUK_BALIK
  BELUM_TERVERIFIKASI
  PENGAYAAN
}

// Aspek keputusan yang diuji soal, per template soal Panduan Induk §8.
enum DecisionType {
  DIAGNOSIS
  PEMERIKSAAN
  INTERPRETASI
  TERAPI
  STABILISASI
  RUJUKAN
  PENCEGAHAN
  KESELAMATAN
  ETIK
}

enum PaymentStatus {
  PENDING
  WAITING_CONFIRMATION
  SETTLEMENT
  EXPIRE
  CANCEL
  DENY
}

enum PaymentMethod {
  DOKU
  MANUAL_TRANSFER
}

model User {
  id        String   @id @default(cuid())
  nama      String
  email     String   @unique
  password  String
  role      Role     @default(PESERTA)
  jenisKelamin String?
  createdAt DateTime @default(now())

  membership Membership?
  sessions   PracticeSession[]
  payments   Payment[]
  shareClaims ShareClaim[]
}

model Membership {
  id            String    @id @default(cuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan          String    @default("Gratis")
  expiryDate    DateTime?
  materiExpiryDate DateTime?
  sessionsUsed  Int       @default(0)
  sessionsTotal Int       @default(0)
  updatedAt     DateTime  @updatedAt
}

model Payment {
  id                    String        @id @default(cuid())
  userId                String
  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId               String        @unique
  amount                Int
  durationDays          Int
  includesMateri        Boolean       @default(false)
  status                PaymentStatus @default(PENDING)
  method                PaymentMethod @default(DOKU)
  dokuTransactionId     String?
  paymentUrl            String?
  expiresAt             DateTime
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  paidAt                DateTime?

  @@index([userId, status])
}

model Category {
  id        String     @id @default(cuid())
  name      String     @unique
  questions Question[]
  slides    Slide[]
}

model Slide {
  id         String    @id @default(cuid())
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])
  title      String
  mimeType   String
  fileSize   Int
  fileData   Bytes
  createdAt  DateTime  @default(now())

  @@index([categoryId])
}

model Question {
  id         String         @id @default(cuid())
  categoryId String
  category   Category       @relation(fields: [categoryId], references: [id])
  pertanyaan String
  opsi       Json
  kunci      String
  pembahasan String
  status     QuestionStatus @default(ACTIVE)
  sourceFile String?
  imageUrl         String?
  imageAttribution String?
  createdAt  DateTime       @default(now())

  // Metadata taksonomi SKD 2026 (Panduan Induk §12 kamus data minimum). Semua
  // opsional: soal existing belum terpetakan (lihat prd.md §5.2, §9 Fase 2) dan
  // pengisiannya adalah pekerjaan inventarisasi terpisah, bukan hasil migrasi otomatis.
  moduleId              ClinicalModule?
  primaryArea           CompetencyArea?
  secondaryAreas        CompetencyArea[] @default([])
  sourceCategory        SourceCategory?
  decisionType          DecisionType?
  sourceDocument        String?
  sourceTable           String?
  sourcePage            String?
  sourceVerificationStatus String?
  reviewer              String?
  reviewDate            DateTime?

  answers SessionAnswer[]
  reports QuestionReport[]

  @@index([status])
}

enum ReportReason {
  KUNCI_SALAH
  PEMBAHASAN_SALAH
  SOAL_TIDAK_JELAS
  GAMBAR_BERMASALAH
  LAINNYA
}

enum ReportStatus {
  BARU
  SELESAI
  DITOLAK
}

model QuestionReport {
  id         String       @id @default(cuid())
  questionId String
  question   Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  userId     String?
  reason     ReportReason
  note       String?
  status     ReportStatus @default(BARU)
  createdAt  DateTime     @default(now())
  resolvedAt DateTime?

  @@index([status, createdAt])
  @@index([questionId])
}

model PracticeSession {
  id             String        @id @default(cuid())
  userId         String?
  user           User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryFilter String?
  totalQuestions Int
  correctCount   Int           @default(0)
  status         SessionStatus @default(IN_PROGRESS)
  mode           SessionMode   @default(LATIHAN)
  expiresAt      DateTime?
  pausedAt       DateTime?
  remainingMs    Int?
  createdAt      DateTime      @default(now())
  finishedAt     DateTime?

  answers SessionAnswer[]

  @@index([userId, status, finishedAt])
}

model SessionAnswer {
  id           String          @id @default(cuid())
  sessionId    String
  session      PracticeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionId   String
  question     Question        @relation(fields: [questionId], references: [id])
  order        Int
  answerLetter String?
  isCorrect    Boolean?
  answeredAt   DateTime?

  @@unique([sessionId, order])
}

enum ShareStatus {
  MENUNGGU
  DISETUJUI
  DITOLAK
}

model ShareClaim {
  id         String      @id @default(cuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform   String
  bukti      String?
  instagram  String?
  screenshots String[] @default([])
  status     ShareStatus @default(MENUNGGU)
  bonusDays  Int         @default(3)
  createdAt  DateTime    @default(now())
  reviewedAt DateTime?

  @@index([status, createdAt])
  @@index([userId])
}
